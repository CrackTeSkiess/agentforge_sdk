# AITabletop API Configuration
# Copy this file to .env and fill in your actual values

# AITabletop API Key
# Get your API key from https://aitabletop.com/settings/api
# Use at_test_ prefix for test keys, at_live_ for production
AITABLETOP_API_KEY=at_test_your_api_key_here

# Optional: API Base URL (default: https://api.aitabletop.com)
# Use http://localhost:8000 for local development
AITABLETOP_BASE_URL=https://api.aitabletop.com
