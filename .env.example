# RL Arena API Configuration
# Copy this file to .env and fill in your actual values

# RL Arena API Key
# Get your API key from https://rlarena.com/settings/api
# Use rla_test_ prefix for test keys, rla_live_ for production
RL_ARENA_API_KEY=rla_live_xxxxxxxxxxxxxxxx

# Optional: API Base URL (default: https://api.rlarena.com)
# Use http://localhost:8000 for local development
RL_ARENA_BASE_URL=https://api.rlarena.com

# Optional: Request timeout in seconds (default: 30)
RL_ARENA_TIMEOUT=30

# Optional: Enable SSL verification (default: true)
# Set to false only for local development with self-signed certificates
RL_ARENA_VERIFY_SSL=true